# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; this example file is committed, so never put real keys here.
ANTHROPIC_API_KEY=your-key-here

# Optional overrides. Defaults are in config/settings.py; uncomment to change one.
# Variables already set in your shell take precedence over this file.
# WARDROBE_CLAUDE_MODEL=claude-opus-5
# WARDROBE_CLAUDE_VISION_MODEL=
# WARDROBE_LLM_EFFORT=high
# WARDROBE_LLM_MAX_TOKENS=16000
# WARDROBE_LLM_TIMEOUT_SECONDS=180
# WARDROBE_MAX_CONCURRENT_LLM_CALLS=4
# WARDROBE_API_KEY_ENV_VAR=ANTHROPIC_API_KEY
# WARDROBE_WEATHER_TIMEOUT_SECONDS=15
# WARDROBE_STYLIST_SUGGESTION_COUNT=3
# WARDROBE_STYLIST_MAX_ITEMS_IN_PROMPT=80
# WARDROBE_STYLIST_MAX_RETRIES=1
# WARDROBE_COMPATIBILITY_THRESHOLD=0.55
# WARDROBE_MAX_FORMALITY_GAP=3
# WARDROBE_REQUIRE_SHOES=true
# WARDROBE_MAX_OUTFITS_ENUMERATED=50000
# WARDROBE_MARGINAL_GAIN_THRESHOLD=3
# WARDROBE_SUGGEST_BUY_TOP_N=5
# Paths: the defaults sit under the repo root. A relative path set here resolves
# from the directory you run `wardrobe` in, so prefer an absolute one.
# WARDROBE_CLOSET_PATH=data/closet.json
# WARDROBE_COMPATIBILITY_CACHE_PATH=data/compatibility.json
# WARDROBE_REPORTS_DIR=reports/runs
